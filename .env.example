# GitHub OAuth — create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub Webhook — set this same secret in your repo webhook settings
GITHUB_WEBHOOK_SECRET=

# Session encryption (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Database
DATABASE_URL=postgresql+asyncpg://growplant:growplant_dev@postgres:5432/growplant

# Redis
REDIS_URL=redis://redis:6379/0
